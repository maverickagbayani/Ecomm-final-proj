                "stations",
                "commonwealth-hub"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Open times (CWH-DC1, tomorrow)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().starts;",
                  "pm.test(\"Has open times\", () => pm.expect(s.length).to.be.above(0));",
                  "if (s.length) pm.collectionVariables.set(\"slotStart\", s[Math.min(4, s.length - 1)].slot_start);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tomorrow in Manila, e.g. 2026-11-17",
                  "const d = new Date(Date.now() + 8*3600*1000 + 24*3600*1000);",
                  "pm.collectionVariables.set(\"date\", d.toISOString().slice(0, 10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stations/commonwealth-hub/availability?connectorId=CWH-DC1&date={{date}}&battery_kwh=60&max_kw=100&start_pct=20&target_pct=80",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stations",
                "commonwealth-hub",
                "availability"
              ],
              "query": [
                {
                  "key": "connectorId",
                  "value": "CWH-DC1"
                },
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "battery_kwh",
                  "value": "60"
                },
                {
                  "key": "max_kw",
                  "value": "100"
                },
                {
                  "key": "start_pct",
                  "value": "20"
                },
                {
                  "key": "target_pct",
                  "value": "80"
                }
              ]
            },
            "description": "Revenue feature 1: only open start times. Saves one into {{slotStart}}."
          }
        },
        {
          "name": "Price preview (quote)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
