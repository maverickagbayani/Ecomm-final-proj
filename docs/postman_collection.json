{
  "info": {
    "name": "WattSpot API (GC2, MongoDB)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "For the MongoDB backend (branch g4/m1-mongodb-switch). Set baseUrl to the Render URL for final evidence. Run 'Open times' first: it saves an open slot into {{slotStart}}."
  },
