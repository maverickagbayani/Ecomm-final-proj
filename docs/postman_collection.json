    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "date",
      "value": ""
    },
    {
      "key": "slotStart",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    }
  ],
  "item": [
