      "item": [
        {
          "name": "List stations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns a list\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stations"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Search: Katipunan",
          "event": [
            {
              "listen": "test",
              "script": {
